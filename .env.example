# ---------------------------------------------------------------------------
# BioFarm Fruits - environment configuration
# Copy this file to ".env" and fill in real values. The .env file is
# gitignored and will NOT be committed.
# ---------------------------------------------------------------------------

# Flask
SECRET_KEY=change-this-to-a-long-random-string
SITE_URL=http://localhost:5000

# --- REAL EMAIL (Gmail SMTP) ----------------------------------------------
# 1. Turn on 2-Step Verification for biofreshf@gmail.com
# 2. Google Account -> Security -> App passwords -> generate one for "Mail"
# 3. Paste the 16-character password (no spaces) as MAIL_PASSWORD in your
#    local .env file (never commit real credentials here).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_DEFAULT_SENDER=you@gmail.com

# --- Company contact details (used across the site) ------------------------
COMPANY_NAME=BioFarm Fruits
COMPANY_PHONE=0746767123
COMPANY_PHONE_ALT=0745395981
COMPANY_WHATSAPP=0746767123
COMPANY_WHATSAPP_ALT=0716091772
COMPANY_EMAIL=biofreshf@gmail.com
COMPANY_ADDRESS=Nairobi, Kenya
COMPANY_TIKTOK=https://www.tiktok.com/@dragon_fruit_012
COMPANY_YOUTUBE=https://www.youtube.com/@bio_fresh_orchard
# Social media links shown in the "Follow Us" icon row.
# Icons only appear when a real URL is set (leave as # to hide).
COMPANY_FACEBOOK=#
COMPANY_INSTAGRAM=#
COMPANY_X=#
COMPANY_LINKEDIN=#

# Optional: PostgreSQL in production (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
